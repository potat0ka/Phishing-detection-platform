# AI Phishing Detection Platform - Environment Configuration
# Copy this file to .env and update with your actual values

# MongoDB Connection
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp

# Flask Configuration
SECRET_KEY=your_secret_key_here
SESSION_SECRET=your_session_secret_here

# Optional: OpenAI API Key (for advanced AI features)
# OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
DEBUG=True
PORT=8080